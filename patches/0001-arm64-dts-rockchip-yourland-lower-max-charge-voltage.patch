From: bin4re <bin4re@foxmail.com>
Date: Tue, 24 Nov 2026 21:10:47 +0800
Subject: [PATCH 1/2] arm64: dts: rockchip: yourland: lower max charge voltage
 to 8.24V (80% cap)

---
 arch/arm64/boot/dts/rockchip/rk3588-yourland.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-yourland.dts b/arch/arm64/boot/dts/rockchip/rk3588-yourland.dts
index c011ef5b30d2..4da4f3312c2b 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-yourland.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-yourland.dts
@@ -467,7 +467,7 @@ sc8886: sc8886@6b {
 		ti,charge-current = <2500000>;
 		ti,max-input-voltage = <12000000>;
 		ti,max-input-current = <6000000>;
-		ti,max-charge-voltage = <8700000>;
+		ti,max-charge-voltage = <8240000>;
 		ti,input-current = <2000000>;
 		ti,input-current-sdp = <1000000>;
 		ti,input-current-dcp = <2000000>;
